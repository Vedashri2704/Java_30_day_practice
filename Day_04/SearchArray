class Main {
    public static void main(String[] args) {
        int[] arr={1,2,3,4,5};
        int target = 3;
        boolean found = false;
        for(int i =0;i<arr.length;i++){
            if(i == target){
                found = true;
                break;
            }
                
            }
        if(found){
            System.out.println("target found");
        }
        else{
                System.out.println("target not found");
            }
        }
       
        
    }
